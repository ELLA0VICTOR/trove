# Optional live integration settings. Never put secret values in VITE_ variables.
# The initial local demo works without these and never claims live integration.
TATUM_API_KEY=
TATUM_MAINNET_API_KEY=
TATUM_ACCOUNT_ID=
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_AGENT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
OPENAI_API_KEY=
COACH_MODEL=gpt-6-luna
# Lifetime allowance shared by coach processes using this database, not a provider billing cap.
COACH_BUDGET_USD=1.00
MARKETSTACK_API_KEY=
# Optional faster stock-data source (server only).
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Neon pooled PostgreSQL URI for Vercel/hosted storage; local SQLite works without it.
DATABASE_URL=
# Account verification and password-reset email (server only).
RESEND_API_KEY=
EMAIL_FROM=Trove <accounts@dixmail.xyz>
ENOKI_SECRET_KEY=
VITE_ENOKI_PUBLIC_KEY=
VITE_GOOGLE_CLIENT_ID=

# Server-only Sui Testnet configuration. Never use a Mainnet wallet here.
SUI_PACKAGE_ID=
SUI_ORIGINAL_PACKAGE_ID=
SUI_TESTNET_SPONSOR_KEY=
SUI_QUOTE_ATTESTOR_KEY=
# Local SQLite directory when DATABASE_URL is absent.
TROVE_DATA_DIR=.trove
PUBLIC_ORIGIN=
PORT=3001
