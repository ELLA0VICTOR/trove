{
  "name": "trove",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:integrations": "node --env-file-if-exists=.env.local --import tsx scripts/check-integrations.ts",
    "format": "prettier --write src server shared tests scripts vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@grpc/grpc-js": "^1.14.6",
    "@hono/node-server": "^2.1.5",
    "@mysten-incubation/memwal": "^0.1.10",
    "@mysten/sui": "^2.37.0",
    "@protobuf-ts/grpc-transport": "^2.11.1",
    "@tailwindcss/vite": "^4.3.3",
    "hono": "^4.13.14",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
